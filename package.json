{
  "name": "glass-music",
  "version": "1.3.0",
  "description": "Glass Music audio player",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "check": "node --check desktop/main.js && node --check server/index.js && node --check server/services/youtubeProxy.js && node --check public/js/main.js",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "yt-search": "^2.12.1"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.glassmusic.desktop",
    "productName": "Glass Music",
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "J0RG1N77",
        "repo": "GlassMusic"
      }
    ],
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "!desktop/bin/**",
      "!**/node_modules/**/{test,tests,__tests__,docs,examples}/**",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.d.ts"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Glass-Music-Setup-${version}.${ext}",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
